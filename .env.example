# Development, staging, or production. Production validation never defaults to this value.
RELEASE_PROFILE=
# Cloudflare Pages branch context. Production defaults to main; previews always noindex.
CF_PAGES_PRODUCTION_BRANCH=main
# Set only for a deliberately isolated preview with safe test delivery bindings.
PREVIEW_CONTACT_BUILD_APPROVED=
# Must be true, together with every production-readiness gate, before indexing is allowed.
RELEASE_INDEXING_ENABLED=
# pre-incorporation or incorporated. Production requires an explicit truthful legal state.
LEGAL_ENTITY_MODE=
# hidden, scenarios, or portfolio. Portfolio requires eligible evidence-backed records.
PUBLIC_WORK_MODE=
# Legacy only: required if the permanently redirected market-entry routes are reactivated.
# hidden, coordination, or partnered; partnered also requires verified records and approvals.
PUBLIC_MARKET_ENTRY_MODE=
# Set to true only after the corresponding human review.
LEGAL_REVIEW_CONFIRMED=
PUBLIC_COMPANY_DETAILS_CONFIRMED=
APPROVED_MEDIA_CONFIRMED=
PUBLIC_CASE_EVIDENCE_CONFIRMED=
CONTACT_CHANNELS_CONFIRMED=
CONTACT_DELIVERY_VERIFIED=
PRIVACY_NOTICE_COMPLETE=
TERMS_NOTICE_COMPLETE=
# Development-only media replacement guidance.
NEXT_PUBLIC_SHOW_MEDIA_GUIDES=
# Public canonical origin.
NEXT_PUBLIC_SITE_URL=https://www.venusbridge.co.uk
# Public company identity. These values are intentionally blank until confirmed.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_TRADING_NAME_STATEMENT_EN=
NEXT_PUBLIC_TRADING_NAME_STATEMENT_ZH=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_REGISTERED_OFFICE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_WECHAT=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WECHAT_PROFILE=
NEXT_PUBLIC_LEGAL_APPROVAL_STATUS=
NEXT_PUBLIC_TERMS_APPROVAL_STATUS=
NEXT_PUBLIC_PRIVACY_EFFECTIVE_DATE=
NEXT_PUBLIC_TERMS_EFFECTIVE_DATE=
NEXT_PUBLIC_PRIVACY_CONTROLLER_NAME=
# Contact form is compiled into the static export only after all release gates pass.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=
NEXT_PUBLIC_CONTACT_PRIVACY_PROCESSING_APPROVED=
NEXT_PUBLIC_CONTACT_PUBLIC_IDENTITY_CONFIRMED=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Privacy-reviewed measurement gate. Keep disabled until a provider and policy are approved.
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_PRIVACY_APPROVED=

# Cloudflare Pages Function runtime variables (server-only; configure in Cloudflare, never commit values).
CONTACT_FORM_ENABLED=
CONTACT_PRIVACY_PROCESSING_APPROVED=
CONTACT_PUBLIC_IDENTITY_CONFIRMED=
CONTACT_ALLOWED_ORIGINS=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
CONTACT_PREVIEW_RUNTIME_APPROVED=
# Bind a Cloudflare Rate Limiting binding as CONTACT_RATE_LIMITER and a KV namespace as
# CONTACT_DEDUPLICATION. They provide best-effort distributed abuse protection and
# best-effort duplicate suppression; the receiver must deduplicate by idempotency key.
