{
  "name": "venus-bridge-media",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-static-og.mjs && next build",
    "start": "node scripts/serve-static-export.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:release:staging": "node scripts/validate-release.mjs --profile=staging",
    "validate:release:production": "node scripts/validate-release.mjs --profile=production",
    "validate:media": "node scripts/validate-media.mjs --profile=staging",
    "validate:media:production": "node scripts/validate-media.mjs --profile=production",
    "validate:pricing": "node scripts/validate-pricing.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/run-playwright-production.mjs",
    "test:motion": "node scripts/run-playwright-production.mjs e2e/motion.spec.ts e2e/motion-correction.spec.ts",
    "audit:visual": "node scripts/run-playwright-production.mjs e2e/visual-regression.spec.ts",
    "generate:demo-media": "node scripts/generate-demo-media.mjs",
    "import:portfolio-media": "node scripts/import-portfolio-media.mjs",
    "import:phase13-media": "node scripts/import-phase13-media.mjs",
    "docs:phase13": "node scripts/generate-phase13-reports.mjs",
    "audit:phase14-media": "node scripts/phase14-media-audit.mjs",
    "validate:image-crops": "node scripts/validate-image-crops.ts",
    "docs:portfolio": "node scripts/generate-portfolio-docs.mjs",
    "generate:performance-fixtures": "node scripts/generate-performance-fixtures.mjs",
    "audit:performance": "node scripts/real-media-performance-audit.mjs",
    "audit:browsers": "node scripts/phase7-browser-qa.mjs",
    "generate:og": "node scripts/generate-static-og.mjs",
    "evidence:contact-sheet": "node scripts/generate-evidence-contact-sheet.mjs",
    "package:source": "node scripts/package-source.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cobe": "2.0.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
